{
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git * --no-verify*)"
    ],
    "ask": [
      "Edit(./pyproject.toml)",
      "Edit(./cspell.*)",
      "Edit(./.cspell.*)",
      "Edit(./src/gate/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      }
    ]
  }
}
